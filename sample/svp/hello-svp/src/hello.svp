# ---------------------------------------------------------------------------
#  hello.svp
#
#  SVP (Samsung SSP1601) side of the SGDK 'hello-svp' sample.
#
#  The DSP waits for a command word coming from the 68000 through the XST
#  mailbox. On the expected command it writes a magic value into the DRAM
#  shared with the 68000, then answers with the one's complement of the
#  command so that the 68000 can tell a real answer from a stuck bus.
#
#  Assembled by 'ssp16asm' and injected into the ROM image at cartridge byte
#  0x800 by the SGDK build, see makefile.gen.
#
#  Syntax note: every literal is hexadecimal, 1 to 2 digits make a byte and
#  3 to 4 digits make a word, so constants are always written padded.
# ---------------------------------------------------------------------------

# ---- protocol, kept in sync with src/main.c -------------------------------

CmdTest:            EQU 0x1234      # the only command the 68000 sends
MagicValue:         EQU 0xC0DE      # what we drop in DRAM on that command
ReplyBad:           EQU 0xDEAD      # answer to anything else

# ---- hardware constants ---------------------------------------------------

# The two ST bits that pick what the external registers mean. With them clear,
# ext0 is the PM0 status register and ext3 is the XST mailbox; with them set,
# ext0 to ext7 are external memory pointers instead.
StMailbox:          EQU 0x0000
# 0x0030 is what the published SVP samples use. Beware that the two sources
# disagree on the numbering: the reverse engineering notes call these ST5 and
# ST6 (which would be 0x0060) while the samples write 0x0030, i.e. bits 4 and
# 5. It works either way because the test is a mask, not a comparison: only
# bit 5 is actually looked at, and 0x0030 and 0x0060 both contain it. Verified
# on Genesis Plus GX with both values.
StExtMem:           EQU 0x0030

# PM0 bit raised when the 68000 writes the mailbox, cleared when we read PM0.
Pm0M68kWrote:       EQU 0x0002

# external memory access: the first PMC write is the 16 bit word address, the
# second one is the mode word. Mode 0x0018 selects the DRAM the 68000 sees at
# 0x300000, with no auto increment. DRAM word N is at 68000 address
# 0x300000 + 2 * N, so the address word is simply N.
DramWord0:          EQU 0x0000
DramMode:           EQU 0x0018

# ---- code -----------------------------------------------------------------

# The SVP boot code enters cartridge code at the word address held in the ROM
# header at 0x1CE, which this sample sets to 0x400 (cartridge byte 0x800).
org 400

start:                  eor a, a                    # clear the full 32 bit accumulator
                        ld st, @StMailbox

# Poll PM0 until the 68000 drops a word in the mailbox. Reading PM0 clears the
# flag, so the value has to be tested from the accumulator and not re-read.
waitCommand:            ld a, ext0
                        andi a, @Pm0M68kWrote
                        bra z=1, @waitCommand

                        ld x, ext3                  # take the command out of XST
                        ld a, x
                        cmpi a, @CmdTest
                        bra z=0, @badCommand

# ---- expected command: publish the magic value in shared DRAM -------------

                        ld st, @StExtMem            # ext registers become memory pointers
                        ld ext6, @DramWord0         # PMC, first write: word address
                        ld ext6, @DramMode          # PMC, second write: mode word
                        ld ext0, -                  # blind access, arms PM0 for writing
                        ld ext0, @MagicValue        # the real write, hits DRAM word 0
                        ld st, @StMailbox           # ext3 is the XST mailbox again

# ---- answer with the complement of the command ----------------------------

                        ld a, x
                        eori a, FFFF
                        ld ext3, a                  # raises PM0 bit 0 for the 68000
                        bra always, @waitCommand

badCommand:             ld ext3, @ReplyBad
                        bra always, @waitCommand
