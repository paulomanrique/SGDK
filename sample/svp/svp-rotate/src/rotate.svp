# ---------------------------------------------------------------------------
#  rotate.svp
#
#  SVP (Samsung SSP1601) side of the SGDK 'svp-rotate' demo.
#
#  Every frame the DSP rotates eight points around the screen centre using the
#  SSP1601 hardware multiplier and writes the finished screen coordinates into
#  the DRAM shared with the 68000, which only has to drop sprites on them.
#  This is the job the SVP was actually put in the cartridge to do.
#
#  The multiplier is a signed Q15 fractional unit: with X an integer and Y a
#  sine scaled to +-32767, `ld a, p` leaves X * (Y/32768) in the high word of
#  the accumulator, which is exactly x*cos or y*sin with no shifting. `add a,
#  p` and `sub a, p` then accumulate the second term of the rotation directly.
#
#  DRAM layout, from word 0: x0, y0, x1, y1, ... x7, y7 (8 points, 16 words).
#
#  Assembled by 'ssp16asm', injected at cartridge byte 0x800 by the SGDK build.
#
#  NOTE: like plasma.svp this file never uses `ld a, A[nn]` / `ld a, B[nn]`.
#  ssp16asm counts that instruction as zero words in its symbol pass, which
#  silently shifts every label defined after it. RAM is reached through the
#  pointer registers instead, which assemble correctly.
# ---------------------------------------------------------------------------

CmdFrame:           EQU 0x0001      # "rotate the points once"
ReplyDone:          EQU 0x0055      # "the coordinates are in DRAM"

CentreX:            EQU 0x0098      # 152 = screen centre minus half a 16x16 sprite
CentreY:            EQU 0x0068      # 104

QuarterTurn:        EQU 0x0040      # 64 of 256 entries: cos = sin shifted 90 deg
AngleStep:          EQU 0x0002      # rotation speed, table entries per frame

StMailbox:          EQU 0x0000
StExtMem:           EQU 0x0030
Pm0M68kWrote:       EQU 0x0002

DramStart:          EQU 0x0000
DramAutoInc:        EQU 0x0818

org 400

# ---------------------------------------------------------------------------
#  boot: copy the signed sine table into internal RAM bank A
# ---------------------------------------------------------------------------

start:                  eor a, a
                        ld st, @StMailbox
                        ldi r6, 00              # rotation angle

                        ldi r0, 00
copySine:               ld a, r0
                        addi a, @SineTable
                        ld y, (a)
                        ld a, y
                        ld (r0+), a
                        ld a, r0
                        cmpi a, 0000
                        bra z=0, @copySine

# ---------------------------------------------------------------------------
#  main loop
# ---------------------------------------------------------------------------

waitCommand:            ld a, ext0
                        andi a, @Pm0M68kWrote
                        bra z=1, @waitCommand
                        ld x, ext3

# sin and cos of the current angle, parked in RAM bank B so the multiplier can
# reload them for every point without touching the program space table again
                        ld a, r6
                        ld r0, a
                        ld y, (r0)              # sin(angle)
                        ldi r4, 00
                        ld a, y
                        ld (r4), a              # RAM1[0] = sin

                        ld a, r6
                        addi a, @QuarterTurn    # r1 is 8 bit, so this wraps
                        ld r1, a
                        ld y, (r1)              # cos(angle)
                        ldi r4, 01
                        ld a, y
                        ld (r4), a              # RAM1[1] = cos

                        ld st, @StExtMem
                        ld ext6, @DramStart
                        ld ext6, @DramAutoInc
                        ld ext0, -

# ---- point 0: (24, 0) ----------------------------------------------
                        ldi r4, 01
                        ld x, 0018
                        ld y, (r4)              # cos
                        ld a, p                 # A = x * cos
                        ldi r4, 00
                        ld x, 0000
                        ld y, (r4)              # sin
                        sub a, p                # A = x*cos - y*sin
                        addi a, @CentreX
                        ld ext0, a              # screen x

                        ldi r4, 00
                        ld x, 0018
                        ld y, (r4)              # sin
                        ld a, p                 # A = x * sin
                        ldi r4, 01
                        ld x, 0000
                        ld y, (r4)              # cos
                        add a, p                # A = x*sin + y*cos
                        addi a, @CentreY
                        ld ext0, a              # screen y

# ---- point 1: (23, 23) ----------------------------------------------
                        ldi r4, 01
                        ld x, 0017
                        ld y, (r4)              # cos
                        ld a, p                 # A = x * cos
                        ldi r4, 00
                        ld x, 0017
                        ld y, (r4)              # sin
                        sub a, p                # A = x*cos - y*sin
                        addi a, @CentreX
                        ld ext0, a              # screen x

                        ldi r4, 00
                        ld x, 0017
                        ld y, (r4)              # sin
                        ld a, p                 # A = x * sin
                        ldi r4, 01
                        ld x, 0017
                        ld y, (r4)              # cos
                        add a, p                # A = x*sin + y*cos
                        addi a, @CentreY
                        ld ext0, a              # screen y

# ---- point 2: (0, 42) ----------------------------------------------
                        ldi r4, 01
                        ld x, 0000
                        ld y, (r4)              # cos
                        ld a, p                 # A = x * cos
                        ldi r4, 00
                        ld x, 002A
                        ld y, (r4)              # sin
                        sub a, p                # A = x*cos - y*sin
                        addi a, @CentreX
                        ld ext0, a              # screen x

                        ldi r4, 00
                        ld x, 0000
                        ld y, (r4)              # sin
                        ld a, p                 # A = x * sin
                        ldi r4, 01
                        ld x, 002A
                        ld y, (r4)              # cos
                        add a, p                # A = x*sin + y*cos
                        addi a, @CentreY
                        ld ext0, a              # screen y

# ---- point 3: (-36, 36) ----------------------------------------------
                        ldi r4, 01
                        ld x, FFDC
                        ld y, (r4)              # cos
                        ld a, p                 # A = x * cos
                        ldi r4, 00
                        ld x, 0024
                        ld y, (r4)              # sin
                        sub a, p                # A = x*cos - y*sin
                        addi a, @CentreX
                        ld ext0, a              # screen x

                        ldi r4, 00
                        ld x, FFDC
                        ld y, (r4)              # sin
                        ld a, p                 # A = x * sin
                        ldi r4, 01
                        ld x, 0024
                        ld y, (r4)              # cos
                        add a, p                # A = x*sin + y*cos
                        addi a, @CentreY
                        ld ext0, a              # screen y

# ---- point 4: (-60, 0) ----------------------------------------------
                        ldi r4, 01
                        ld x, FFC4
                        ld y, (r4)              # cos
                        ld a, p                 # A = x * cos
                        ldi r4, 00
                        ld x, 0000
                        ld y, (r4)              # sin
                        sub a, p                # A = x*cos - y*sin
                        addi a, @CentreX
                        ld ext0, a              # screen x

                        ldi r4, 00
                        ld x, FFC4
                        ld y, (r4)              # sin
                        ld a, p                 # A = x * sin
                        ldi r4, 01
                        ld x, 0000
                        ld y, (r4)              # cos
                        add a, p                # A = x*sin + y*cos
                        addi a, @CentreY
                        ld ext0, a              # screen y

# ---- point 5: (-49, -49) ----------------------------------------------
                        ldi r4, 01
                        ld x, FFCF
                        ld y, (r4)              # cos
                        ld a, p                 # A = x * cos
                        ldi r4, 00
                        ld x, FFCF
                        ld y, (r4)              # sin
                        sub a, p                # A = x*cos - y*sin
                        addi a, @CentreX
                        ld ext0, a              # screen x

                        ldi r4, 00
                        ld x, FFCF
                        ld y, (r4)              # sin
                        ld a, p                 # A = x * sin
                        ldi r4, 01
                        ld x, FFCF
                        ld y, (r4)              # cos
                        add a, p                # A = x*sin + y*cos
                        addi a, @CentreY
                        ld ext0, a              # screen y

# ---- point 6: (0, -78) ----------------------------------------------
                        ldi r4, 01
                        ld x, 0000
                        ld y, (r4)              # cos
                        ld a, p                 # A = x * cos
                        ldi r4, 00
                        ld x, FFB2
                        ld y, (r4)              # sin
                        sub a, p                # A = x*cos - y*sin
                        addi a, @CentreX
                        ld ext0, a              # screen x

                        ldi r4, 00
                        ld x, 0000
                        ld y, (r4)              # sin
                        ld a, p                 # A = x * sin
                        ldi r4, 01
                        ld x, FFB2
                        ld y, (r4)              # cos
                        add a, p                # A = x*sin + y*cos
                        addi a, @CentreY
                        ld ext0, a              # screen y

# ---- point 7: (62, -62) ----------------------------------------------
                        ldi r4, 01
                        ld x, 003E
                        ld y, (r4)              # cos
                        ld a, p                 # A = x * cos
                        ldi r4, 00
                        ld x, FFC2
                        ld y, (r4)              # sin
                        sub a, p                # A = x*cos - y*sin
                        addi a, @CentreX
                        ld ext0, a              # screen x

                        ldi r4, 00
                        ld x, 003E
                        ld y, (r4)              # sin
                        ld a, p                 # A = x * sin
                        ldi r4, 01
                        ld x, FFC2
                        ld y, (r4)              # cos
                        add a, p                # A = x*sin + y*cos
                        addi a, @CentreY
                        ld ext0, a              # screen y

                        ld a, r6                # advance the angle
                        addi a, @AngleStep
                        ld r6, a                # r6 is 8 bit, wraps on its own

                        ld st, @StMailbox
                        ld ext3, @ReplyDone
                        bra always, @waitCommand

# ---------------------------------------------------------------------------
#  256 entry signed sine table, one period scaled to +-32767 (Q15).
#  Four hex digits per entry on purpose: ssp16asm mis-sizes a `dw` whose
#  operand has one or two digits.
# ---------------------------------------------------------------------------

SineTable:
                        dw 0000
                        dw 0324
                        dw 0648
                        dw 096A
                        dw 0C8C
                        dw 0FAB
                        dw 12C8
                        dw 15E2
                        dw 18F9
                        dw 1C0B
                        dw 1F1A
                        dw 2223
                        dw 2528
